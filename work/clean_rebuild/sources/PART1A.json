  "records": [
    {
      "index": 0,
      "policy": "translate",
      "text": "Game Hall",
      "layout_policy": "adaptive"
    },
    {
      "index": 1,
      "policy": "translate",
      "text": "Yamada Kasuke",
      "layout_policy": "adaptive"
    },
    {
      "index": 2,
      "policy": "translate",
      "text": "Ilyu",
      "layout_policy": "adaptive"
    },
    {
      "index": 3,
      "policy": "translate",
      "text": "Want to switch games and play one more round?",
      "layout_policy": "adaptive"
    },
    {
      "index": 4,
      "policy": "translate",
      "text": "Kasuke",
      "layout_policy": "adaptive"
    },
    {
      "index": 5,
      "policy": "translate",
      "text": "You're on. What are we playing?",
      "layout_policy": "adaptive"
    },
    {
      "index": 6,
      "policy": "translate",
      "text": "How about Indian poker? Know how to play?",
      "layout_policy": "adaptive"
    },
    {
      "index": 7,
      "policy": "translate",
      "text": "Ask for the rules.",
      "layout_policy": "adaptive"
    },
    {
      "index": 8,
      "policy": "translate",
      "text": "Do not insult me!",
      "layout_policy": "adaptive"
    },
    {
      "index": 9,
      "policy": "translate",
      "text": "Teach me.",
      "layout_policy": "adaptive"
    },
    {
      "index": 10,
      "policy": "translate",
      "text": "We each draw one card and show it to the other person, without looking at our own. Then we bet based on what we see.",
      "layout_policy": "adaptive"
    },
    {
      "index": 11,
      "policy": "translate",
      "text": "And the card rankings?",
      "layout_policy": "adaptive"
    },
    {
      "index": 12,
      "policy": "translate",
      "text": "Two is high. Then ace, king, queen, jack, ten down to four. Three is low. Set the bet, call, show your cards. High card wins.",
      "layout_policy": "adaptive"
    },
    {
      "index": 13,
      "policy": "translate",
      "text": "So I can see your card, but you can't...",
      "layout_policy": "adaptive"
    },
    {
      "index": 14,
      "policy": "translate",
      "text": "And you can see mine, but you have no idea how strong your own card is.",
      "layout_policy": "adaptive"
    },
    {
      "index": 15,
      "policy": "translate",
      "text": "That's a pretty suggestive little game...reminds me of something. All right. Let's play.",
      "layout_policy": "adaptive"
    },
    {
      "index": 16,
      "policy": "translate",
      "text": "I get it. I read your face when you see my card.",
      "layout_policy": "adaptive"
    },
    {
      "index": 17,
      "policy": "translate",
      "text": "Heh. You look tough. But I'm a liar.",
      "layout_policy": "adaptive"
    },
    {
      "index": 18,
      "policy": "translate",
      "text": "Most women are liars anyway. Let's play.",
      "layout_policy": "adaptive"
    },
    {
      "index": 19,
      "policy": "translate",
      "text": "Three tokens each.",
      "layout_policy": "adaptive"
    },
    {
      "index": 20,
      "policy": "translate",
      "text": "Run out of tokens, you lose.",
      "layout_policy": "adaptive"
    },
    {
      "index": 21,
      "policy": "translate",
      "text": "Got it?",
      "layout_policy": "adaptive"
    },
    {
      "index": 22,
      "policy": "translate",
      "text": "I'll strip you bare.",
      "layout_policy": "adaptive"
    },
    {
      "index": 23,
      "policy": "translate",
      "text": "Shall we?",
      "layout_policy": "adaptive"
    },
    {
      "index": 24,
      "policy": "translate",
      "text": "Let's go!",
      "layout_policy": "adaptive"
    },
    {
      "index": 25,
      "policy": "translate",
      "text": "Not bad.",
      "layout_policy": "adaptive"
    },
    {
      "index": 26,
      "policy": "translate",
      "text": "Now it begins!",
      "layout_policy": "adaptive"
    },
    {
      "index": 27,
      "policy": "translate",
      "text": "I'm staying in...",
      "layout_policy": "adaptive"
    },
    {
      "index": 28,
      "policy": "translate",
      "text": "This'll be over soon.",
      "layout_policy": "adaptive"
    },
    {
      "index": 29,
      "policy": "translate",
      "text": "A three...I've got her. Raise the stakes and strip her bare!",
      "layout_policy": "adaptive"
    },
    {
      "index": 30,
      "policy": "translate",
      "text": "Ilyu has a seven...that's a tricky number...",
      "layout_policy": "adaptive"
    },
    {
      "index": 31,
      "policy": "translate",
      "text": "A jack...damn, that's tough.",
      "layout_policy": "adaptive"
    },
    {
      "index": 32,
      "policy": "translate",
      "text": "A two...call and I'm dead. Scare her into folding, or beg for mercy?",
      "layout_policy": "adaptive"
    },
    {
      "index": 33,
      "policy": "translate",
      "text": "I can already see your crying face.",
      "layout_policy": "adaptive"
    },
    {
      "index": 34,
      "policy": "translate",
      "text": "She's coming on strong...does that mean my card is bad? Or is she bluffing?",
      "layout_policy": "adaptive"
    },
    {
      "index": 35,
      "policy": "translate",
      "text": "Well? Feeling confident?",
      "layout_policy": "adaptive"
    },
    {
      "index": 36,
      "policy": "translate",
      "text": "How the hell should I know my own card?!",
      "layout_policy": "adaptive"
    },
    {
      "index": 37,
      "policy": "translate",
      "text": "...",
      "layout_policy": "adaptive"
    },
    {
      "index": 38,
      "policy": "translate",
      "text": "She's backing off...did I draw something good?",
      "layout_policy": "adaptive"
    },
    {
      "index": 39,
      "policy": "translate",
      "text": "Keep pressing!",
      "layout_policy": "adaptive"
    },
    {
      "index": 40,
      "policy": "translate",
      "text": "I won't let her read my face!",
      "layout_policy": "adaptive"
    },
    {
      "index": 41,
      "policy": "translate",
      "text": "Play it timid...",
      "layout_policy": "adaptive"
    },
    {
      "index": 42,
      "policy": "translate",
      "text": "Luck's run out, Ilyu. Don't come crying to me.",
      "layout_policy": "adaptive"
    },
    {
      "index": 43,
      "policy": "translate",
      "text": "Well now...",
      "layout_policy": "adaptive"
    },
    {
      "index": 44,
      "policy": "translate",
      "text": "...",
      "layout_policy": "adaptive"
    },
    {
      "index": 45,
      "policy": "translate",
      "text": "You really think that card can make me cry?",
      "layout_policy": "adaptive"
    },
    {
      "index": 46,
      "policy": "translate",
      "text": "...this is getting tense.",
      "layout_policy": "adaptive"
    },
    {
      "index": 47,
      "policy": "translate",
      "text": "Change the stakes?",
      "layout_policy": "adaptive"
    },
    {
      "index": 48,
      "policy": "translate",
      "text": "3",
      "layout_policy": "fixed"
    },
    {
      "index": 49,
      "policy": "translate",
      "text": "2",
      "layout_policy": "fixed"
    },
    {
      "index": 50,
      "policy": "translate",
      "text": "1",
      "layout_policy": "fixed"
    },
    {
      "index": 51,
      "policy": "translate",
      "text": "Three tokens.",
      "layout_policy": "adaptive"
    },
    {
      "index": 52,
      "policy": "translate",
      "text": "Two tokens...",
      "layout_policy": "adaptive"
    },
    {
      "index": 53,
      "policy": "translate",
      "text": "Keep the stakes as they are.",
      "layout_policy": "adaptive"
    },
    {
      "index": 54,
      "policy": "translate",
      "text": "I accept. Will you call or fold?",
      "layout_policy": "adaptive"
    },
    {
      "index": 55,
      "policy": "translate",
      "text": "I'll fold.",
      "layout_policy": "adaptive"
    },
    {
      "index": 56,
      "policy": "translate",
      "text": "Call",
      "layout_policy": "adaptive"
    },
    {
      "index": 57,
      "policy": "translate",
      "text": "Fold",
      "layout_policy": "adaptive"
    },
    {
      "index": 58,
      "policy": "translate",
      "text": "Call.",
      "layout_policy": "adaptive"
    },
    {
      "index": 59,
      "policy": "translate",
      "text": "...I'll fold.",
      "layout_policy": "adaptive"
    },
    {
      "index": 60,
      "policy": "translate",
      "text": "You have an eight.",
      "layout_policy": "adaptive"
    },
    {
      "index": 61,
      "policy": "translate",
      "text": "Hardly worth celebrating. I had you beat anyway.",
      "layout_policy": "adaptive"
    },
    {
      "index": 62,
      "policy": "translate",
      "text": "I had a seven! Oh, lucky me! I should've raised the stakes more.",
      "layout_policy": "adaptive"
    },
    {
      "index": 63,
      "policy": "translate",
      "text": "Damn! So I was close!",
      "layout_policy": "adaptive"
    },
    {
      "index": 64,
      "policy": "translate",
      "text": "You had an eight. I had...a seven.",
      "layout_policy": "adaptive"
    },
    {
      "index": 65,
      "policy": "translate",
      "text": "Not bad.",
      "layout_policy": "adaptive"
    },
    {
      "index": 66,
      "policy": "translate",
      "text": "You have an ace. This is not even a contest...",
      "layout_policy": "adaptive"
    },
    {
      "index": 67,
      "policy": "translate",
      "text": "I came pretty close.",
      "layout_policy": "adaptive"
    },
    {
      "index": 68,
      "policy": "translate",
      "text": "I had a seven! Hee hee, you are such a fool! If you knew what your card was, you would want to jump overboard! Curious? I won't tell. It's a secret. Hee hee!",
      "layout_policy": "adaptive"
    },
    {
      "index": 69,
      "policy": "translate",
      "text": "I don't want to know! ...damn it...",
      "layout_policy": "adaptive"
    },
    {
      "index": 70,
      "policy": "translate",
      "text": "I had a seven. You had an ace. Feel good, beating a little girl like me?",
      "layout_policy": "adaptive"
    },
    {
      "index": 71,
      "policy": "translate",
      "text": "Not bad.",
      "layout_policy": "adaptive"
    },
    {
      "index": 72,
      "policy": "translate",
      "text": "You had a four. Something is not right...what did I have?",
      "layout_policy": "adaptive"
    },
    {
      "index": 73,
      "policy": "translate",
      "text": "That will remain a mystery forever.",
      "layout_policy": "adaptive"
    },
    {
      "index": 74,
      "policy": "translate",
      "text": "That was wise.",
      "layout_policy": "adaptive"
    },
    {
      "index": 75,
      "policy": "translate",
      "text": "Gee, thanks!",
      "layout_policy": "adaptive"
    },
    {
      "index": 76,
      "policy": "translate",
      "text": "You had a four. I had a seven. That was close.",
      "layout_policy": "adaptive"
    },
    {
      "index": 77,
      "policy": "translate",
      "text": "Damn!",
      "layout_policy": "adaptive"
    },
    {
      "index": 78,
      "policy": "translate",
      "text": "You had an eight...",
      "layout_policy": "adaptive"
    },
    {
      "index": 79,
      "policy": "translate",
      "text": "Waaaaah!",
      "layout_policy": "adaptive"
    },
    {
      "index": 80,
      "policy": "translate",
      "text": "I had a jack...",
      "layout_policy": "adaptive"
    },
    {
      "index": 81,
      "policy": "translate",
      "text": "My luck just won't turn around...",
      "layout_policy": "adaptive"
    },
    {
      "index": 82,
      "policy": "translate",
      "text": "I had a jack! That was scary, but you had an eight. A nice win.",
      "layout_policy": "adaptive"
    },
    {
      "index": 83,
      "policy": "translate",
      "text": "Thank goodness!",
      "layout_policy": "adaptive"
    },
    {
      "index": 84,
      "policy": "translate",
      "text": "You had an ace. Lucky you.",
      "layout_policy": "adaptive"
    },
    {
      "index": 85,
      "policy": "translate",
      "text": "That scared me. You're pretty lucky too.",
      "layout_policy": "adaptive"
    },
    {
      "index": 86,
      "policy": "translate",
      "text": "I had a jack. You're honest. If you're easy to bluff, life won't be easy.",
      "layout_policy": "adaptive"
    },
    {
      "index": 87,
      "policy": "translate",
      "text": "What? I won? Really?",
      "layout_policy": "adaptive"
    },
    {
      "index": 88,
      "policy": "translate",
      "text": "You had an ace...and I drew a jack, of all things...",
      "layout_policy": "adaptive"
    },
    {
      "index": 89,
      "policy": "translate",
      "text": "Whew, that scared me. You're bad for my heart.",
      "layout_policy": "adaptive"
    },
    {
      "index": 90,
      "policy": "translate",
      "text": "You had a four. What did I have?",
      "layout_policy": "adaptive"
    },
    {
      "index": 91,
      "policy": "translate",
      "text": "I pulled it off! Bwahahaha!",
      "layout_policy": "adaptive"
    },
    {
      "index": 92,
      "policy": "translate",
      "text": "I had a jack. Playing it safe was smart. Folding was right.",
      "layout_policy": "adaptive"
    },
    {
      "index": 93,
      "policy": "translate",
      "text": "What did I have?",
      "layout_policy": "adaptive"
    },
    {
      "index": 94,
      "policy": "translate",
      "text": "I had the prince of fortune! You had a pauper's four.",
      "layout_policy": "adaptive"
    },
    {
      "index": 95,
      "policy": "translate",
      "text": "Oh my God...",
      "layout_policy": "adaptive"
    },
    {
      "index": 96,
      "policy": "translate",
      "text": "You had an eight...",
      "layout_policy": "adaptive"
    },
    {
      "index": 97,
      "policy": "translate",
      "text": "Now that was satisfying!",
      "layout_policy": "adaptive"
    },
    {
      "index": 98,
      "policy": "translate",
      "text": "I had a two. Do you always flee when the odds turn against you?",
      "layout_policy": "adaptive"
    },
    {
      "index": 99,
      "policy": "translate",
      "text": "Depends on the opponent!",
      "layout_policy": "adaptive"
    },
    {
      "index": 100,
      "policy": "translate",
      "text": "I had a two. You had an eight. Do you enjoy hopeless battles?",
      "layout_policy": "adaptive"
    },
    {
      "index": 101,
      "policy": "translate",
      "text": "A man has to rise to the challenge.",
      "layout_policy": "adaptive"
    },
    {
      "index": 102,
      "policy": "translate",
      "text": "You had an ace. I couldn't have won.",
      "layout_policy": "adaptive"
    },
    {
      "index": 103,
      "policy": "translate",
      "text": "Not always.",
      "layout_policy": "adaptive"
    },
    {
      "index": 104,
      "policy": "translate",
      "text": "I had a two. You had a good card. What a shame.",
      "layout_policy": "adaptive"
    },
    {
      "index": 105,
      "policy": "translate",
      "text": "That was no contest.",
      "layout_policy": "adaptive"
    },
    {
      "index": 106,
      "policy": "translate",
      "text": "You had an ace. I had a two! If you'd pushed harder, I would've folded.",
      "layout_policy": "adaptive"
    },
    {
      "index": 107,
      "policy": "translate",
      "text": "Do that next time...",
      "layout_policy": "adaptive"
    },
    {
      "index": 108,
      "policy": "translate",
      "text": "You had a four...",
      "layout_policy": "adaptive"
    },
    {
      "index": 109,
      "policy": "translate",
      "text": "Ah! What a rush!",
      "layout_policy": "adaptive"
    },
    {
      "index": 110,
      "policy": "translate",
      "text": "I had a two. A fair result.",
      "layout_policy": "adaptive"
    },
    {
      "index": 111,
      "policy": "translate",
      "text": "How can I fight a monster card like that?",
      "layout_policy": "adaptive"
    },
    {
      "index": 112,
      "policy": "translate",
      "text": "You had a four. I had a two. A crushing win. We make a good pair.",
      "layout_policy": "adaptive"
    },
    {
      "index": 113,
      "policy": "translate",
      "text": "Hmph!",
      "layout_policy": "adaptive"
    },
    {
      "index": 114,
      "policy": "translate",
      "text": "You had an eight. What did I have?",
      "layout_policy": "adaptive"
    },
    {
      "index": 115,
      "policy": "translate",
      "text": "Bad luck.",
      "layout_policy": "adaptive"
    },
    {
      "index": 116,
      "policy": "translate",
      "text": "I had a three! Are you mocking me? Why did you fold?",
      "layout_policy": "adaptive"
    },
    {
      "index": 117,
      "policy": "translate",
      "text": "I merely let you win!",
      "layout_policy": "adaptive"
    },
    {
      "index": 118,
      "policy": "translate",
      "text": "You had an eight. I had a three. That's awful...",
      "layout_policy": "adaptive"
    },
    {
      "index": 119,
      "policy": "translate",
      "text": "Life is not always kind.",
      "layout_policy": "adaptive"
    },
    {
      "index": 120,
      "policy": "translate",
      "text": "You had an ace.",
      "layout_policy": "adaptive"
    },
    {
      "index": 121,
      "policy": "translate",
      "text": "I was bound to win that one.",
      "layout_policy": "adaptive"
    },
    {
      "index": 122,
      "policy": "translate",
      "text": "You had an ace! I had a three! Idiot! Why didn't you call?",
      "layout_policy": "adaptive"
    },
    {
      "index": 123,
      "policy": "translate",
      "text": "I had my reasons...",
      "layout_policy": "adaptive"
    },
    {
      "index": 124,
      "policy": "translate",
      "text": "You had an ace. I had a three. I'm sick of this...",
      "layout_policy": "adaptive"
    },
    {
      "index": 125,
      "policy": "translate",
      "text": "You had a four. What was my card?",
      "layout_policy": "adaptive"
    },
    {
      "index": 126,
      "policy": "translate",
      "text": "We don't tell people who fold...",
      "layout_policy": "adaptive"
    },
    {
      "index": 127,
      "policy": "translate",
      "text": "I had a three! If you'd called, you'd have won for sure...",
      "layout_policy": "adaptive"
    },
    {
      "index": 128,
      "policy": "translate",
      "text": "I did you a favor!",
      "layout_policy": "adaptive"
    },
    {
      "index": 129,
      "policy": "translate",
      "text": "I had a three. You had a four. I can't believe I lost.",
      "layout_policy": "adaptive"
    },
    {
      "index": 130,
      "policy": "translate",
      "text": "That is how it goes.",
      "layout_policy": "adaptive"
    },
    {
      "index": 131,
      "policy": "translate",
      "text": "Too bad.",
      "layout_policy": "adaptive"
    },
    {
      "index": 132,
      "policy": "translate",
      "text": "This doesn't bode well for the voyage...",
      "layout_policy": "adaptive"
    },
    {
      "index": 133,
      "policy": "translate",
      "text": "You're pretty good.",
      "layout_policy": "adaptive"
    },
    {
      "index": 134,
      "policy": "translate",
      "text": "Thanks to you, this voyage is looking up.",
      "layout_policy": "adaptive"
    },
    {
      "index": 135,
      "policy": "preserve",
      "text": null
    }
  ]
}
