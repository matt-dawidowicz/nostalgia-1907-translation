    },
    {
      "index": 145,
      "policy": "translate",
      "text": "Chief Engineer",
      "display_text": "Chief Eng.",
      "layout_policy": "adaptive"
    },
    {
      "index": 146,
      "policy": "translate",
      "text": "No, Captain! If the bomb is Japanese-made, it'll be incredibly complicated. The instant we try to move it...boom!",
