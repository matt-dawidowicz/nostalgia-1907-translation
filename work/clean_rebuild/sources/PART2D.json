    },
    {
      "index": 141,
      "policy": "translate",
      "text": "A bomb! Where is it, Locke?!",
      "layout_policy": "adaptive"
    },
    {
      "index": 142,
      "policy": "translate",
      "text": "A-aft section, starboard cargo hold...i-it's sitting right in front of me...ticking, ticking! A r-real bomb!",
