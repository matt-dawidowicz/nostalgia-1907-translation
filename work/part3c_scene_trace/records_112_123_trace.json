  "manifest": {
    "112": {
      "text": "Why are you relying on\nme now?",
      "units": 16,
      "pad_final_row": false,
      "wrap_layout": {
        "first": 12,
        "continuation": 10
      },
      "runtime_layout": {
        "first": 12,
        "continuation": 11
      }
    },
    "113": {
      "text": "You bastard! You     \nforced me to         \nconfess!",
      "units": 27,
      "pad_final_row": false,
      "wrap_layout": {
        "first": 12,
        "continuation": 10
      },
      "runtime_layout": {
        "first": 12,
        "continuation": 11
      }
    },
    "114": {
      "text": "The person offering  \nyou sanctuary may be \nbehind the bombing,  \nan agent of a third  \ncountry. Then        \nBritain is not your  \ndestination at all.",
      "units": 77,
      "pad_final_row": false,
      "wrap_layout": {
        "first": 12,
        "continuation": 10
      },
      "runtime_layout": {
        "first": 12,
        "continuation": 11
      }
    },
    "115": {
      "text": "That is absurd...",
      "units": 10,
      "pad_final_row": false,
      "wrap_layout": {
        "first": 12,
        "continuation": 10
      },
      "runtime_layout": {
        "first": 12,
        "continuation": 11
      }
    },
    "116": {
      "text": "Pathetic.            ",
      "units": 11,
      "pad_final_row": true,
      "wrap_layout": {
        "first": 10,
        "continuation": 10
      },
      "runtime_layout": {
        "first": 11,
        "continuation": 11
      }
    },
    "117": {
      "text": "Try any little       \ntrick...              ",
      "units": 22,
      "pad_final_row": true,
      "wrap_layout": {
        "first": 10,
        "continuation": 10
      },
      "runtime_layout": {
        "first": 11,
        "continuation": 11
      }
    },
    "118": {
      "text": "...and I will snap   \nyour neck!           ",
      "units": 22,
      "pad_final_row": true,
      "wrap_layout": {
        "first": 10,
        "continuation": 10
      },
      "runtime_layout": {
        "first": 11,
        "continuation": 11
      }
    },
    "119": {
      "text": "Enough! I will kill  \nyou!                 ",
      "units": 22,
      "pad_final_row": true,
      "wrap_layout": {
        "first": 10,
        "continuation": 10
      },
      "runtime_layout": {
        "first": 11,
        "continuation": 11
      }
    },
    "120": {
      "text": "He is huge...   ",
      "units": 8,
      "pad_final_row": true,
      "wrap_layout": {
        "first": 8,
        "continuation": 8
      },
      "runtime_layout": {
        "first": 8,
        "continuation": 8
      }
    },
    "121": {
      "text": "The bomber is neither\na Russian nor a      \nBritish agent. He is \na thief acting under \nanother country's    \norders.",
      "units": 60,
      "pad_final_row": false,
      "wrap_layout": {
        "first": 12,
        "continuation": 10
      },
      "runtime_layout": {
        "first": 12,
        "continuation": 11
      }
    },
    "122": {
      "text": "You are lying!",
      "units": 8,
      "pad_final_row": false,
      "wrap_layout": {
        "first": 12,
        "continuation": 10
      },
      "runtime_layout": {
        "first": 12,
        "continuation": 11
      }
    },
    "123": {
      "text": "Calm down! A third   \ncountry is trying to \nsteal you!",
      "units": 28,
      "pad_final_row": false,
      "wrap_layout": {
        "first": 12,
        "continuation": 10
      },
      "runtime_layout": {
        "first": 12,
        "continuation": 11
      }
    }
  },
